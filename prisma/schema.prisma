// FMF Cards — schema dati
// Tutti gli importi monetari sono interi in centesimi (Int, "...Cents") per evitare
// errori di arrotondamento in virgola mobile. Le percentuali sono interi in millesimi
// di punto percentuale ("...Bps", basis points: 3000 = 30,00%).

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Game {
  POKEMON
  ONE_PIECE
  YUGIOH
  DRAGON_BALL
}

enum Language {
  IT
  JP
  CN
  KR
  EN
}

enum Condition {
  NEW
  B_GRADE
}

// Stato della confezione esterna. Usato solo per i box giapponesi, dove si vendono fino a 3
// varianti dello stesso prodotto (prezzi diversi): sigillato con pellicola, senza pellicola
// (confezione apribile ma contenuto integro), danneggiato.
enum PackagingCondition {
  SEALED // con pellicola (sigillato)
  NO_WRAP // senza pellicola
  DAMAGED // danneggiato
}

// Se il costo del fornitore è al netto o al lordo di IVA: definisce come il motore
// prezzi deve trattare il valore memorizzato in supplierCostCents.
enum CostVatTreatment {
  NET_OF_VAT
  GROSS_WITH_VAT
}

enum MatchStatus {
  MATCHED // abbinato con certezza al fornitore (codice prodotto esatto)
  NEEDS_REVIEW // abbinamento ambiguo, in attesa di revisione manuale
  UNMATCHED // nessun prodotto fornitore corrispondente trovato
  MANUAL // abbinamento confermato manualmente da un operatore
}

enum Role {
  CUSTOMER
  RESELLER
  ADMIN
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_CONFIRMED
  AVAILABILITY_CHECK
  TO_PROCURE
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CARD
  PAYPAL
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum SyncStatus {
  SUCCESS
  PARTIAL
  ERROR
}

enum SyncTrigger {
  MANUAL
  SCHEDULED
  IMPORT_FILE
}

model Product {
  id String @id @default(cuid())

  // Identificazione
  supplierCode String? // codice prodotto del fornitore, se disponibile
  name         String // nome originale del fornitore
  slug         String  @unique

  game      Game
  language  Language
  category  String // bucket di catalogo: pokemon-it, pokemon-jp, pokemon-cn, pokemon-kr, one-piece-jp, one-piece-cn, bgrade
  setName   String
  setCode   String?
  type      String // Booster box, Slim box, Display, Tin, Deck, ...
  condition Condition @default(NEW)

  imageUrl    String?
  description String? // descrizione HTML dal fornitore, quando disponibile

  // Prezzo pubblico: unico, impostato a mano dall'admin, SEMPRE IVA inclusa. Nessun calcolo
  // automatico da costo/margine: è il prezzo mostrato a tutti i clienti (null = non ancora in vendita).
  // Per i booster box giapponesi è anche il prezzo "con pellicola" (sigillato).
  priceCents Int?
  // Prezzo dedicato ai rivenditori approvati (ruolo RESELLER), impostato a mano dall'admin,
  // SEMPRE IVA inclusa. Se null, il rivenditore vede il prezzo pubblico come tutti gli altri.
  resellerPriceCents Int?

  // Prezzi alternativi SOLO per i booster box giapponesi (vedi isJpBoosterBox): se impostati,
  // il cliente può scegliere la confezione direttamente nella scheda prodotto. Null = quella
  // variante non è in vendita per questo prodotto (il selettore non la mostra).
  noWrapPriceCents  Int? // prezzo senza pellicola
  damagedPriceCents Int? // prezzo danneggiato

  // Costo di acquisto: riferimento interno per l'admin (non mostrato ai clienti, non usato
  // per calcolare il prezzo pubblico, che è manuale).
  supplierCostCents Int? // costo di acquisto, null = non tracciato
  costVatTreatment  CostVatTreatment @default(NET_OF_VAT)
  costIsEstimated   Boolean          @default(true) // true finché non arriva un costo reale verificato
  vatRateBps        Int              @default(2200) // aliquota IVA per il prezzo pubblico, configurabile per prodotto

  // Disponibilità
  stockQty            Int? // null = disponibilità non tracciata, 0 = esaurito, >0 = quantità nota
  stockLastCheckedAt  DateTime?

  published  Boolean @default(true)
  isNew      Boolean @default(false)
  isPreorder Boolean @default(false)
  archived   Boolean   @default(false) // nascosto dal catalogo e dalla lista prodotti attivi, ma recuperabile
  deletedAt  DateTime? // eliminazione "soft": il prodotto resta nel DB (serve per lo storico ordini) ma sparisce ovunque tranne che nella sezione "Eliminati"

  matchStatus MatchStatus @default(UNMATCHED)

  supplierLinkId String?       @unique
  supplierLink   SupplierLink?

  orderItems    OrderItem[]
  changeLogs    ProductChangeLog[]
  variants      ProductVariant[]
  resellerTiers ResellerPriceTier[]

  createdAt DateTime @updatedAt @default(now())
  updatedAt DateTime @updatedAt

  @@index([game, language, category])
  @@index([published])
}

// Riga del catalogo fornitore (Toreca) importata da CSV/XLSX o da lettura pagina.
// Serve come tabella "di appoggio" per l'abbinamento ai Product e per conservare
// il dato grezzo del fornitore indipendentemente dal catalogo pubblicato.
model SupplierLink {
  id String @id @default(cuid())

  supplierCode   String?
  supplierName   String
  costCents      Int?
  costVatTreatment CostVatTreatment @default(NET_OF_VAT)
  stockQty       Int?
  sourceUrl      String?
  lastSeenAt     DateTime @default(now())

  product   Product? @relation(fields: [productId], references: [id])
  productId String?  @unique

  matchConfidence String? // "exact-code" | "normalized-name" | "manual" | null

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierCode])
}

model ProductChangeLog {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  field     String
  oldValue  String?
  newValue  String?
  changedBy String // email/id dell'operatore admin
  changedAt DateTime @default(now())

  @@index([productId])
}

model SyncLog {
  id          String      @id @default(cuid())
  trigger     SyncTrigger
  source      String // es. "csv-import", "xlsx-import", "manual-edit"
  status      SyncStatus
  startedAt   DateTime    @default(now())
  finishedAt  DateTime?
  createdCount   Int @default(0)
  updatedCount   Int @default(0)
  unavailableCount Int @default(0)
  errorCount     Int @default(0)
  notes       String?
  triggeredBy String? // email admin, o "system" per le pianificate

  errors SyncError[]
}

model SyncError {
  id          String   @id @default(cuid())
  syncLog     SyncLog  @relation(fields: [syncLogId], references: [id])
  syncLogId   String
  identifier  String // codice o nome prodotto che ha causato l'errore
  message     String
  createdAt   DateTime @default(now())

  @@index([syncLogId])
}

// Messaggi dal modulo "Scrivici" del Centro assistenza. Senza un servizio email
// configurato, questo è il modo affidabile per far arrivare le richieste: compaiono
// subito nella dashboard admin invece di dipendere da un invio email esterno.
model ContactMessage {
  id        String   @id @default(cuid())
  email     String
  orderNumber String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([read])
}

// Impostazioni generali — riga singola, modificabile dall'area admin. I prezzi dei
// prodotti sono manuali (vedi Product.priceCents): qui restano solo le regole che
// valgono per tutto il sito (IVA in fattura, spedizione).
model PricingSettings {
  id Int @id @default(1)

  // I prezzi del sito sono SEMPRE IVA INCLUSA. Questa aliquota serve solo a scorporare
  // la quota IVA mostrata in fattura; non cambia il totale pagato.
  invoiceVatRateBps     Int     @default(2200) // 22,00%
  freeShippingThresholdCents Int @default(20000) // 200,00 €
  standardShippingFeeCents   Int @default(790) // 7,90 €

  updatedAt DateTime @updatedAt
  updatedBy String?
}

enum ResellerRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Richiesta di accesso come rivenditore/distributore ("Lavora con noi"). Valutata
// manualmente da un admin: non crea da sola un account né un listino scontato.
model ResellerRequest {
  id String @id @default(cuid())

  companyName String
  vatNumber   String
  sdiCode     String?
  contactName String
  email       String
  phone       String?
  message     String?

  status ResellerRequestStatus @default(PENDING)
  note   String? // nota interna admin (es. motivo del rifiuto, condizioni concordate)

  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  reviewedBy String?

  @@index([status])
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String?
  role         Role    @default(CUSTOMER)

  companyName String?
  vatNumber   String?
  sdiCode     String?

  // Consenso esplicito alle email di marketing (offerte, novità): di default false,
  // si attiva solo con un'azione dell'utente (checkbox in registrazione o nell'account).
  marketingOptIn Boolean @default(false)

  addresses   Address[]
  orders      Order[]
  resetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Link di recupero password. Senza un servizio email configurato, il link viene
// mostrato direttamente a schermo dopo la richiesta invece di essere inviato via
// email — funziona comunque, ma va collegato a un provider email reale prima del
// lancio pubblico (altrimenti chiunque conosca l'email di un utente potrebbe vedere
// il link solo se ha accesso allo schermo di chi lo richiede: nessun rischio nuovo,
// ma non è l'esperienza finale voluta).
model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Address {
  id        String  @id @default(cuid())
  user      User    @relation(fields: [userId], references: [id])
  userId    String
  label     String?
  fullName  String
  street    String
  postalCode String
  city      String
  province  String
  country   String  @default("IT")
  phone     String?
  isDefault Boolean @default(false)

  createdAt DateTime @default(now())
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique

  user       User?   @relation(fields: [userId], references: [id])
  userId     String?
  guestEmail String?

  status        OrderStatus   @default(PENDING_PAYMENT)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  // Totali congelati al momento dell'ordine (sempre ricalcolati server-side).
  // Tutti gli importi sono SEMPRE IVA inclusa. invoiceVatCents è la quota IVA già compresa
  // nel totale (informativa, per la fattura); totalCents = subtotale - sconto + spedizione.
  subtotalCents   Int
  discountCents   Int @default(0)
  couponCode      String? // codice sconto applicato, se presente (vedi DiscountCode)
  shippingCents   Int
  invoiceVatCents Int @default(0)
  totalCents      Int

  // Spedizione / fatturazione
  shipName     String
  shipStreet   String
  shipPostal   String
  shipCity     String
  shipProvince String
  shipCountry  String  @default("IT")
  shipPhone    String?

  invoiceRequested Boolean @default(false)
  companyName      String?
  vatNumber        String?
  sdiCode          String?

  customerNote String?

  trackingCarrier String?
  trackingNumber  String?

  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

/// Variante acquistabile di un prodotto (es. box "Rivali Predestinati" → "Busta singola"),
/// con un prezzo pubblico proprio IVA inclusa. Il prodotto principale resta acquistabile
/// con il suo prezzo; le varianti non hanno magazzino proprio né prezzo rivenditore
/// (i rivenditori pagano il prezzo pubblico della variante).
model ProductVariant {
  id         String  @id @default(cuid())
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  name       String
  priceCents Int
  position   Int     @default(0)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

/// Scaglioni di prezzo per i rivenditori approvati (uguali per tutti i rivenditori): da
/// minQty pezzi in su il prezzo unitario è priceCents (IVA inclusa). Vale lo scaglione con
/// la soglia più alta raggiunta dalla quantità in carrello; sotto il primo scaglione vale
/// Product.resellerPriceCents (o il prezzo pubblico se non impostato).
model ResellerPriceTier {
  id         String  @id @default(cuid())
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId  String
  minQty     Int
  priceCents Int

  createdAt DateTime @default(now())

  @@unique([productId, minQty])
}

model OrderItem {
  id      String @id @default(cuid())
  order   Order  @relation(fields: [orderId], references: [id])
  orderId String

  product   Product? @relation(fields: [productId], references: [id])
  productId String?

  // Snapshot al momento dell'ordine: non deve cambiare se il prodotto cambia dopo
  nameSnapshot        String
  unitPriceCentsSnapshot Int
  supplierCostCentsSnapshot Int?
  packagingSnapshot   PackagingCondition? // confezione scelta, solo per i booster box JP
  // Variante scelta (es. "Busta singola"), null = prodotto principale. Il nome resta
  // nello storico anche se la variante viene poi modificata o eliminata.
  variant             ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId           String?
  variantNameSnapshot String?
  quantity            Int
  lineTotalCents      Int

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  order     Order       @relation(fields: [orderId], references: [id])
  orderId   String
  status    OrderStatus
  note      String?
  changedBy String? // email admin, o "system"
  changedAt DateTime    @default(now())

  @@index([orderId])
}

// Codice sconto (es. "FMFCARDS" per il 5% sul primo ordine). Applicabile a tutto il
// carrello come percentuale sul subtotale. Gestito dall'area admin (/admin/sconti).
model DiscountCode {
  id            String    @id @default(cuid())
  code          String    @unique // sempre maiuscolo, confrontato case-insensitive
  percentOffBps Int // 500 = 5,00% di sconto sul subtotale
  active        Boolean   @default(true)
  maxUses       Int? // null = nessun limite di utilizzi totali (su tutti i clienti insieme)
  maxUsesPerUser Int? // null = nessun limite per singolo cliente (per account o email ospite)
  usedCount     Int       @default(0)
  expiresAt     DateTime? // null = nessuna scadenza
  createdAt     DateTime  @default(now())
  createdBy     String?
}

enum MarketingCampaignStatus {
  DRAFT
  SENDING
  SENT
  FAILED
  SCHEDULED
  CANCELED
}

// Email di marketing (offerte, novità): create e inviate dall'admin dalla sezione
// Marketing. Inviate solo agli utenti con marketingOptIn true, una email per volta
// via API batch (mai con più destinatari nello stesso campo "to"). Una volta inviata
// una campagna resta solo consultabile: per rimandare lo stesso contenuto se ne crea
// una nuova (nessuna modifica dopo l'invio, per avere uno storico affidabile).
model MarketingCampaign {
  id             String                  @id @default(cuid())
  subject        String
  bodyHtml       String
  status         MarketingCampaignStatus @default(DRAFT)
  recipientCount Int?
  failedCount    Int?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  sentAt         DateTime?
  createdBy      String?

  // Invio gestito dal sito (vedi src/lib/marketing-engine.ts)
  segmentKey  String    @default("all") // gruppo di destinatari, es. "all", "clienti", "pokemon"
  previewText String? // anteprima mostrata accanto all'oggetto nella casella di posta
  scheduledAt DateTime? // invio programmato

  sends MarketingSend[]
}

enum MarketingSendStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

/// Una singola email di marketing (campagna o automazione) a un destinatario: è insieme
/// la coda di invio (status QUEUED), il registro di quanto inviato nelle ultime 24 ore
/// (per il limite giornaliero) e la base delle statistiche (aperture, clic, disiscrizioni).
model MarketingSend {
  id             String              @id @default(cuid())
  // "c:<campagna>:<email>" · "a:welcome:<email>" · "a:abandoned:<ordine>": impedisce doppioni
  dedupeKey      String              @unique
  campaign       MarketingCampaign?  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId     String?
  automationKey  String?
  email          String
  firstName      String?
  refId          String? // es. id ordine per il promemoria ordine non completato
  status         MarketingSendStatus @default(QUEUED)
  error          String?
  resendEmailId  String?
  queuedAt       DateTime            @default(now())
  sentAt         DateTime?
  openedAt       DateTime?
  openCount      Int                 @default(0)
  clickedAt      DateTime?
  clickCount     Int                 @default(0)
  unsubscribedAt DateTime?

  clicks MarketingClick[]

  @@index([status, queuedAt])
  @@index([sentAt])
  @@index([campaignId])
}

model MarketingClick {
  id        String        @id @default(cuid())
  send      MarketingSend @relation(fields: [sendId], references: [id], onDelete: Cascade)
  sendId    String
  url       String
  createdAt DateTime      @default(now())

  @@index([sendId])
}

/// Email automatiche: "welcome" (dopo l'iscrizione) e "abandoned_order" (ordine creato ma
/// non pagato). Testo modificabile dal pannello, attivabili/disattivabili.
model MarketingAutomation {
  key        String   @id
  enabled    Boolean  @default(false)
  subject    String
  bodyHtml   String
  delayHours Int      @default(0)
  updatedAt  DateTime @updatedAt
}

/// Stato del motore di invio: evita che due esecuzioni lavorino la coda insieme.
model MarketingEngineState {
  id        Int      @id @default(1)
  lockedAt  DateTime @default(now())
  lastRunAt DateTime @default(now())
}

/// Iscritti alla newsletter dal modulo del sito (anche senza account) o importati dal
/// pannello. Dal modulo serve la doppia conferma: l'iscrizione vale solo dopo il clic sul
/// link ricevuto via email (status CONFIRMED); gli importati sono confermati dall'admin.
model NewsletterSubscriber {
  id                String           @id @default(cuid())
  email             String           @unique
  status            NewsletterStatus @default(PENDING)
  interests         String[] // giochi scelti nel modulo: pokemon, onepiece, yugioh, dragonball
  confirmToken      String           @unique
  confirmSentAt     DateTime?
  confirmedAt       DateTime?
  unsubscribedAt    DateTime?
  firstName         String?
  source            String           @default("newsletter") // newsletter | import
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

enum NewsletterStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

