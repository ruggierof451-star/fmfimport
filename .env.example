# Copia questo file in .env e completa i valori prima di avviare il progetto.

# Stringa di connessione al database. In sviluppo è un file SQLite locale;
# in produzione può diventare una stringa Postgres (vedi README per la migrazione).
DATABASE_URL="file:./dev.db"

# Chiave segreta usata per firmare i cookie di sessione (login). Deve essere una stringa
# lunga e casuale, diversa tra sviluppo e produzione. Generarla con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Credenziali per il primo account amministratore creato dallo script di seed.
# Da cambiare subito dopo il primo accesso.
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""

# Stripe (pagamenti). Lasciare vuoto per restare in modalità test/demo: il checkout
# funziona ma non effettua alcun addebito reale finché queste chiavi non sono impostate.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# URL pubblico del sito (usato per sitemap.xml e i link assoluti). In produzione va
# impostato al dominio reale, es. "https://www.fmfimport.it".
SITE_URL="http://localhost:3000"

# Resend (https://resend.com) — invio email transazionali: recupero password,
# conferma ordine, notifiche. Senza questa chiave le email non vengono inviate
# (restano solo loggate/mostrate a schermo in sviluppo).
RESEND_API_KEY=""
EMAIL_FROM="FMF Import <onboarding@resend.dev>"
