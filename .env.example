# Copia questo file in .env e completa i valori prima di avviare il progetto.

# Stringa di connessione al database. In sviluppo è un file SQLite locale;
# in produzione può diventare una stringa Postgres (vedi README per la migrazione).
DATABASE_URL="file:./dev.db"

# Chiave segreta usata per firmare i cookie di sessione (login). Deve essere una stringa
# lunga e casuale, diversa tra sviluppo e produzione. Generarla con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Credenziali per il primo account amministratore creato dallo script di seed.
# Da cambiare subito dopo il primo accesso.
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""

# Stripe (pagamenti). Lasciare vuoto per restare in modalità test/demo: il checkout
# funziona ma non effettua alcun addebito reale finché queste chiavi non sono impostate.
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Vercel Blob — archivio per le foto caricate dall'admin quando si aggiunge un prodotto.
# Da attivare su vercel.com: progetto → Storage → Create Database → Blob. Una volta creato,
# Vercel imposta da solo questa variabile sul progetto (non va copiata a mano in produzione).
# Senza questa variabile l'upload foto è disattivato e resta solo il campo URL immagine.
BLOB_READ_WRITE_TOKEN=""

# URL pubblico del sito (usato per sitemap.xml e i link assoluti). In produzione va
# impostato al dominio reale, es. "https://www.fmfcards.com".
SITE_URL="https://www.fmfcards.com"

# Resend (https://resend.com) — invio email transazionali: recupero password,
# conferma ordine, notifiche. Senza questa chiave le email non vengono inviate
# (restano solo loggate/mostrate a schermo in sviluppo).
RESEND_API_KEY=""
EMAIL_FROM="FMF Cards <onboarding@resend.dev>"

# Dati per il bonifico bancario (metodo di pagamento secondario, oltre a Stripe),
# mostrati solo nell'email di conferma ordine quando il cliente paga con bonifico.
# SENZA questa variabile l'email NON riporta l'IBAN (il cliente riceve solo un avviso
# che i dati arriveranno a parte): impostarla prima del lancio pubblico.
BANK_IBAN=""
BANK_ACCOUNT_HOLDER="FMF Cards S.R.L.S."

# Mittente delle email di marketing (facoltativo, altrimenti EMAIL_FROM), es. "FMF Cards <news@fmfcards.com>"
EMAIL_MARKETING_FROM=""

# Email marketing gestito dal sito (Admin → Marketing). Resend fa solo da postino.
# Limite del piano Resend in 24 ore (gratuito: 100) e quota sempre lasciata libera alle
# email degli ordini: il marketing usa al massimo la differenza (100 - 30 = 70 al giorno).
MARKETING_DAILY_EMAIL_LIMIT="100"
MARKETING_RESERVED_FOR_ORDERS="30"
# Segreto per il giro giornaliero della coda (vercel.json → crons): Vercel lo invia
# da solo in Authorization se la variabile è impostata nel progetto.
CRON_SECRET=""
